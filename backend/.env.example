# Flask
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_CONTENT_LENGTH_MB=8

# TiDB Cloud (MySQL-compatible). Paste the complete SQLAlchemy URL from your TiDB connection dialog.
# Example: mysql+pymysql://USER:PASSWORD@HOST:4000/DBNAME?ssl_verify_cert=true&ssl_verify_identity=true
# URL-encode special characters in username/password. Never commit real credentials.
TIDB_URL=mysql+pymysql://USER:PASSWORD@HOST:4000/DBNAME?ssl_verify_cert=true&ssl_verify_identity=true

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=folioport_portfolio
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Bootstrap admin: used ONLY by `python -m scripts.create_admin`; do not use a weak production password.
